# ==============================================================================
# Spider_XHS 环境变量示例
# ==============================================================================
# 复制为 .env 后填写真实值：docker compose 会自动读取同级目录的 .env
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # 生成 SECRET_KEY
#
# .env 已被 .gitignore 忽略，切勿提交真实密钥。
# ==============================================================================

# --- 必填：JWT 签名 / Cookie 加密（两者都为空时由 SECRET_KEY 派生 Fernet key）----
# 生产环境留空会直接拒绝启动（backend/app/core/config.py::assert_runtime_safety）
SECRET_KEY=

# 可选：单独指定 Fernet key（44 字符 base64，可用
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成）
FERNET_KEY=

# --- 运行环境 -----------------------------------------------------------------
ENVIRONMENT=production
# compose 默认用 production.yaml；也可指向 /app/config/default.yaml
CONFIG_FILE=/app/config/production.yaml

# --- 数据库 -------------------------------------------------------------------
# sqlite（单容器开箱可用）| mysql
DATABASE_TYPE=sqlite
DATABASE_SQLITE_PATH=./data/spider_xhs.db
# DATABASE_TYPE=mysql 时使用：
# DATABASE_MYSQL_HOST=mysql
# DATABASE_MYSQL_PORT=3306
# DATABASE_MYSQL_USER=spider_xhs
# DATABASE_MYSQL_PASSWORD=
# DATABASE_MYSQL_DATABASE=spider_xhs

# MySQL 容器（docker-compose.yml 里被注释的 mysql 段）使用：
# MYSQL_ROOT_PASSWORD=
# MYSQL_PASSWORD=

# --- 服务端口 -----------------------------------------------------------------
# 默认只绑回环地址（管理后台持有平台账号 Cookie，不应默认暴露公网）。
# 需要公网访问时改成 0.0.0.0，并在前面加反向代理（TLS）。
APP_BIND_ADDR=127.0.0.1

# --- CORS ---------------------------------------------------------------------
# 生产环境禁止 "*"，填写实际前端地址，逗号分隔
# BACKEND_CORS_ORIGINS=https://your-domain.com

# --- 后台调度器 ---------------------------------------------------------------
# 定时发布 / 监控刷新 / 发布任务对账，生产建议开启
SCHEDULER_ENABLED=true

# --- 安全开关（按需显式开启/关闭）-----------------------------------------------
# 是否允许 AI 模型端点指向私网/环回地址（本地 Ollama 等）。
# 生产环境未显式设置时默认 false（防内网探测）。
# ALLOW_PRIVATE_MODEL_ENDPOINTS=false
# 注册开关：生产环境未显式设置时默认关闭
# REGISTRATION_ENABLED=false
# 认证限流（IP+用户名 每分钟尝试次数）
# AUTH_RATE_LIMIT_PER_MINUTE=10

# ==============================================================================
# 优化项配置（均可省略，省略时使用下方默认值）
# ==============================================================================

# --- 分布式限流 -----------------------------------------------------------------
# 设置后登录限流 / 抓取限速在多 worker、多副本间共享计数。
# 单进程部署可留空（回退进程内存实现）。
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=
# 每账号每分钟最大抓取次数（0 = 停止抓取）
CRAWL_RATE_LIMIT_PER_MINUTE=5

# --- SQLite 自动备份 --------------------------------------------------------------
# 每 24h 执行 VACUUM INTO 快照，保留最近 N 份；MySQL 后端自动跳过
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
BACKUP_KEEP=7

# --- 日志与指标 -------------------------------------------------------------------
# 1 = 输出 JSON 行日志（便于采集）
LOG_JSON=0
LOG_LEVEL=INFO
# 指标端点：GET /api/metrics（Prometheus 文本格式，无需额外依赖）

# --- 长任务 -----------------------------------------------------------------------
# 手动运行自动运营任务的同步等待上限（秒）；超过则返回 202 + 任务 ID
TASK_SYNC_WAIT_SECONDS=90
TASK_WORKERS=4

# --- 抖音 vendor 隔离 -------------------------------------------------------------
# 默认子进程执行（崩溃隔离 + 硬超时）；=1 时退回同进程（仅排障用）
DOUYIN_VENDOR_INPROCESS=0

# --- 剪辑工坊（OpenCut）-----------------------------------------------------------
CLIP_EDITOR_PUBLIC_BASE_URL=http://127.0.0.1:3000
CLIP_EDITOR_ALLOWED_ORIGINS=http://127.0.0.1:3000
CLIP_MAX_EXPORT_BYTES=2147483648
CLIP_SESSION_TTL_HOURS=12
CLIP_MAX_ACTIVE_SESSIONS=3
CLIP_USER_EXPORT_QUOTA_BYTES=10737418240
CLIP_EDITOR_BIND_ADDR=127.0.0.1
