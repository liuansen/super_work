# Version control
.git
.gitignore

# Node modules (rebuilt during build)
node_modules
frontend/node_modules

# Python cache
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache

# Environment and secrets（INF-2：覆盖所有 .env 变体，防止密钥进镜像）
.env
.env.*
frontend/.env
frontend/.env.*
**/.env
**/.env.*
!.env.example

# Database files
*.db
*.db-shm
*.db-wal
data/

# Storage artifacts (mounted as volumes)
backend/app/storage/media/*
backend/app/storage/exports/*

# IDE and editor
.vscode
.idea
*.swp
*.swo

# CI/CD and tooling
.superpowers
.claude
.github

# Documentation and planning files
findings.md
progress.md
task_plan.md
AGENTS.md

# OS files
Thumbs.db
.DS_Store

# Test artifacts
tests/
frontend/e2e/
frontend/playwright.config.ts
frontend/test-results/
frontend/playwright-report/
htmlcov/
.coverage

# 本地工作区快照与校验产物（INF-2）
.local/
.workbench-verification/
docs/
scripts/rotate_secrets.py

# Git worktree 元数据
.celeste
.worktrees
